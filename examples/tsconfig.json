{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node", "react"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["lib", "tests", "types", "prisma.config.ts", "playwright.config.ts"]
}
